{
  "name": "dsh-session-vault",
  "version": "0.1.8",
  "description": "\u9762\u5411 DSH rc.7 \u7684\u5b89\u5168\u4f1a\u8bdd\u7ba1\u7406\u63d2\u4ef6\uff1a\u5f52\u6863\u6062\u590d\u3001\u65e0\u9650\u5236\u56de\u6536\u7ad9\u3001\u6279\u91cf\u64cd\u4f5c\u4e0e\u6c38\u4e45\u6e05\u9664\u3002",
  "author": "fujunchao",
  "repository": {
    "type": "git",
    "url": "https://github.com/fujunchao/dsh-session-vault.git"
  },
  "homepage": "https://github.com/fujunchao/dsh-session-vault",
  "bugs": {
    "url": "https://github.com/fujunchao/dsh-session-vault/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "session-management",
    "archive",
    "trash"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.json --emitDeclarationOnly",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --typecheck.enabled --typecheck.tsconfig tsconfig.test.json",
    "smoke": "node tests/bundle-smoke.mjs",
    "integration": "node --test tests/host-integration.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm smoke && pnpm integration"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.21.0",
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-agent": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.7-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.7-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.1.7-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.1.7-rc.2",
    "@deepseek-ai/dsh-workspace": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.7-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "0.1.7-rc.2",
    "@deepseek-ai/dsh-api-workspace-controller": "0.1.7-rc.2"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "zod": "^4.4.3"
  }
}
